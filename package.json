{
  "name": "credat",
  "version": "0.1.1-alpha.1",
  "description": "AI-native TypeScript SDK for eIDAS 2.0 verifiable credentials",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/storage/sqlite.d.ts",
        "default": "./dist/storage/sqlite.js"
      },
      "require": {
        "types": "./dist/storage/sqlite.d.cts",
        "default": "./dist/storage/sqlite.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "eidas",
    "verifiable-credentials",
    "ssi",
    "sd-jwt",
    "openid4vc",
    "openid4vci",
    "openid4vp",
    "mdoc",
    "did",
    "identity",
    "typescript"
  ],
  "author": "Maxime Mansiet",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "cbor-x": "^1.6.0"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.2.3",
    "better-sqlite3": "^11.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
